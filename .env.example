# ==============================================================================
# DevCapacity Manager — Configuration Environnement (.env)
# ==============================================================================

NODE_ENV=development
PORT_API=4000
PORT_WEB=3000

# Base de données PostgreSQL 16 (Locale Docker ou Cloud Neon/Supabase pour Option 3)
# Pour Docker local :
DATABASE_URL="postgresql://devcapacity:devcapacity_secret@localhost:5432/devcapacity_db?schema=public"
# Pour Cloud (Option 3, ex: Neon / Supabase) :
# DATABASE_URL="postgresql://[user]:[password]@[host]:[port]/[db]?sslmode=require"

# Paramètres Docker Compose
DB_USER=devcapacity
DB_PASSWORD=devcapacity_secret
DB_NAME=devcapacity_db
DB_PORT=5432
ADMINER_PORT=8085

# Sécurité & Sessions
SESSION_SECRET="devcapacity_super_secret_session_key_32_characters_min"
JWT_SECRET="devcapacity_jwt_signing_key_change_in_production"

# Mode Authentification de repli (pour dev sans Entra ID)
ENABLE_LOCAL_AUTH=true

# Microsoft Graph API (Outlook M365)
USE_GRAPH_MOCK=true
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
ALIKO_EMAIL="aliko@safirconsulting.net"

# Configuration Envoi d'E-mails Réels (Nodemailer SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ==============================================================================
# Connecteur SAP Business One (Serveur sapdev.safirconsulting.net)
# ==============================================================================
# Hôte distant et accès RDP (Bureau à distance Windows)
SAP_SERVER_HOST="sapdev.safirconsulting.net"
SAP_RDP_PORT=1525

# Service Layer SAP B1 (API REST officielle - Port HTTPS 50000 par défaut)
SAP_B1_SERVICE_LAYER_URL="https://sapdev.safirconsulting.net:50000/b1s/v1"
SAP_B1_COMPANY_DB=""
SAP_B1_USERNAME=""
SAP_B1_PASSWORD=""
SAP_B1_VERIFY_SSL=false

# Connexion directe Base de données SQL (Optionnel - SQL Server 1433 / HANA 30015)
SAP_DB_HOST="sapdev.safirconsulting.net"
SAP_DB_PORT=1433
SAP_DB_NAME=""
SAP_DB_USER=""
SAP_DB_PASSWORD=""

# Paramètres Métier
TIMEZONE_DEFAULT="Europe/Paris"
WORK_HOURS_PER_DAY=8
WORK_DAYS_PER_WEEK=5
