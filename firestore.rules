rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les utilisateurs authentifiés ont accès à leurs données et aux tickets partagés
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'ADMIN' || request.auth.token.role == 'HEAD');
    }
    
    match /tickets/{ticketId} {
      allow read, write: if request.auth != null;
      
      match /comments/{commentId} {
        allow read, write: if request.auth != null;
      }
      
      match /blockers/{blockerId} {
        allow read, write: if request.auth != null;
      }
    }
    
    match /timeEntries/{entryId} {
      allow read, write: if request.auth != null;
    }
    
    match /consultants/{consultantId} {
      allow read, write: if request.auth != null;
    }

    match /developers/{developerId} {
      allow read, write: if request.auth != null;
    }
  }
}

