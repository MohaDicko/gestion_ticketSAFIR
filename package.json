{
  "name": "devcapacity-manager",
  "version": "1.0.0",
  "description": "Plateforme intelligente de gestion des tickets, des addons et des ressources de développement - Safir Consulting",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "vercel-build": "npm run build --workspace=@devcapacity/shared && npm run build --workspace=@devcapacity/web",
    "test": "npm run test --workspaces --if-present",
    "test:vitest": "vitest run",
    "test:playwright": "playwright test",
    "test:owasp": "vitest run tests/owasp-zap/owasp-security.test.ts",
    "test:all": "vitest run && playwright test",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
